# ============================================================
# Copiar este archivo como .env y completar los valores
# Este archivo SÍ se versiona en git (sin credenciales reales)
# ============================================================

# --- Base de datos ---
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# --- Credenciales API ---
API_USERNAME=
API_PASSWORD=

# --- Interoperabilidad Oracle Cloud ---
# Patrón regex del referer permitido (dejar vacío para desactivar)
ORACLE_REFERER_PATTERN=^https://plugins-[^/]+(\.[^/]+)*\.fs\.ocs\.oraclecloud\.com/

# IP de la oficina con acceso directo por X-Forwarded-For (dejar vacío para desactivar)
OFFICE_IP=

# --- Control de acceso local ---
# URL permitida para desarrollo (ej: http://127.0.0.1:5500). Vacío en QA/Prod.
ALLOWED_LOCAL_ORIGIN=

# --- Modo debug ---
# true = muestra trazas de error (desarrollo/QA). false = oculta trazas (producción).
APP_DEBUG=false
