              "raw": "{\n  \"id_texto\": \"CABLE-001\",\n  \"name\": \"Cable Troncal Norte\",\n  \"nombre_esp\": \"Cable de fibra optica 48 hilos\",\n  \"colocacion\": \"Troncal\",\n  \"puntos\": [\n    { \"longitud\": -74.0617, \"latitud\": 4.6737 },\n    { \"longitud\": -74.0618, \"latitud\": 4.6738 },\n    { \"longitud\": -74.0619, \"latitud\": 4.6739 }\n  ]\n}",
