            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/camaras",
              "host": ["{{baseUrl}}"],
              "path": ["api", "camaras"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "user-header", "value": "tecnico_001", "description": "Usuario para trazabilidad (opcional)", "disabled": true }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Subterranea\",\n  \"id_texto\": \"CAM-001\",\n  \"nombre_esp\": \"Camara Principal\",\n  \"ubicacion\": \"Calle 100 #15-20\",\n  \"apertura\": \"Tapa circular\",\n  \"propietari\": \"ETB\",\n  \"estado_cam\": \"Operativa\",\n  \"codigo_etb\": \"ETB-CAM-001\",\n  \"latitud\": 4.6737,\n  \"longitud\": -74.0617\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Inserta una nueva camara. Estado inicial: 'pendiente'. El objectid se genera automaticamente.\n\nCampos requeridos: latitud, longitud (o geometry en WKT POINT).",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{username}}", "type": "string" },
                { "key": "password", "value": "{{password}}", "type": "string" }
