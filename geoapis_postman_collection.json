    {
      "name": "ETA / Oracle Field Service",
      "item": [
        {
          "name": "Obtener ubicacion del tecnico",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/eta/ubicacion-tecnico?activity_id=8854269",
              "host": ["{{baseUrl}}"],
              "path": ["api", "eta", "ubicacion-tecnico"],
              "query": [
                { "key": "activity_id", "value": "8854269", "description": "ID de la actividad OFS (campo 'aid' enviado por el plugin Oracle). Obligatorio." }
              ]
            },
            "description": "Obtiene la ubicacion actual del tecnico asignado a una actividad OFS.\n\nFlujo interno del servidor:\n1. Consulta GET /rest/ofscCore/v1/activities/{activity_id} -> extrae resourceId\n2. Consulta GET /rest/ofscCore/v1/resources/custom-actions/lastKnownPositions?resources={resourceId}\n3. Si no hay posicion reciente, retorna las coordenadas de la actividad como fallback\n\nRespuesta exitosa:\n{\n  \"resourceId\": \"<id_del_recurso>\",\n  \"lat\": 4.6737,\n  \"lng\": -74.0617,\n  \"timestamp\": \"2024-01-15T10:30:00Z\",\n  \"source\": \"last_known_position\",\n  \"activity_coords\": { \"lat\": 4.67, \"lng\": -74.06 }\n}\n\nRequiere configuracion de ETA_BASE_URL, ETA_USERNAME y ETA_PASSWORD en el servidor.",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{username}}", "type": "string" },
                { "key": "password", "value": "{{password}}", "type": "string" }
              ]
            }
          }
        }
      ]
    }
  ]
}
