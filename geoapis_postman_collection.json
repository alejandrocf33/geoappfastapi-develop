{
  "info": {
    "name": "GeoAPIs - Colección Completa",
    "description": "Colección completa de la API GeoAPIs para gestión de infraestructura geoespacial ETB.\n\n## Variables de entorno requeridas\n- `baseUrl`: URL base del servidor (ej. https://web-production-ddf8.up.railway.app)\n- `username`: Usuario de autenticación Basic\n- `password`: Contraseña de autenticación Basic\n\n## Autenticación\nTodos los endpoints usan HTTP Basic Auth con las variables {{username}} y {{password}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{username}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://web-production-ddf8.up.railway.app", "type": "string" },
    { "key": "username", "value": "", "type": "string" },
    { "key": "password", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Operaciones de Lectura",
      "item": [
        {
          "name": "Consultar camaras",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/camaras?lat=4.6737&lon=-74.0617&radio_externo=500&radio_interno=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "camaras"],
              "query": [
                { "key": "lat", "value": "4.6737", "description": "Latitud del punto central (grados decimales WGS84)" },
                { "key": "lon", "value": "-74.0617", "description": "Longitud del punto central (grados decimales WGS84)" },
                { "key": "radio_externo", "value": "500", "description": "Radio externo en metros (limite maximo de busqueda)" },
                { "key": "radio_interno", "value": "0", "description": "Radio interno en metros - excluye elementos mas cercanos (opcional)", "disabled": true }
              ]
            },
            "description": "Obtiene las camaras dentro de un radio alrededor de un punto. Sin parametros retorna las primeras 100.",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{username}}", "type": "string" },
                { "key": "password", "value": "{{password}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Consultar todas las camaras (cache)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/all_camaras",
              "host": ["{{baseUrl}}"],
              "path": ["api", "all_camaras"]
            },
            "description": "Retorna todas las camaras. Usa cache de 6 horas.",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{username}}", "type": "string" },
                { "key": "password", "value": "{{password}}", "type": "string" }
              ]
            }
          }
        },
