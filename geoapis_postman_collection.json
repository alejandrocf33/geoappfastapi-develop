    {
      "name": "Operaciones Logicas",
      "item": [
        {
          "name": "Detectar camaras en falla",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/camaras_en_falla?lat=4.6737&lon=-74.0617&distancia=100&desviacion=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "camaras_en_falla"],
              "query": [
                { "key": "lat", "value": "4.6737", "description": "Latitud del punto central de analisis (grados decimales WGS84)" },
                { "key": "lon", "value": "-74.0617", "description": "Longitud del punto central de analisis (grados decimales WGS84)" },
                { "key": "distancia", "value": "100", "description": "Radio de busqueda inicial en metros" },
                { "key": "desviacion", "value": "10", "description": "Distancia adicional para camaras cercanas fuera del radio (default: 10m)", "disabled": true }
              ]
            },
            "description": "Analiza un area y detecta camaras potencialmente en falla. Retorna dos colecciones: camaras_en_radio y camaras_cercanas.",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{username}}", "type": "string" },
                { "key": "password", "value": "{{password}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Buscar cables cercanos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cables_cercanos?lat=4.6737&lon=-74.0617&distancia=200",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cables_cercanos"],
              "query": [
                { "key": "lat", "value": "4.6737", "description": "Latitud del punto central (grados decimales WGS84)" },
                { "key": "lon", "value": "-74.0617", "description": "Longitud del punto central (grados decimales WGS84)" },
                { "key": "distancia", "value": "200", "description": "Radio de busqueda en metros" },
                { "key": "limite", "value": "100", "description": "Cantidad maxima de resultados (default: 100)", "disabled": true },
                { "key": "incluir_troncales", "value": "false", "description": "Incluir cables troncales (default: false)", "disabled": true },
                { "key": "nombre_cable", "value": "", "description": "Nombre del cable para filtrar (opcional)", "disabled": true },
                { "key": "busqueda_exacta", "value": "true", "description": "Busqueda exacta del nombre (default: true). false usa LIKE %nombre%", "disabled": true }
              ]
            },
            "description": "Obtiene cables dentro de un radio con opciones de filtrado. Incluye distancia al punto en la respuesta.",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{username}}", "type": "string" },
                { "key": "password", "value": "{{password}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Calcular linea en ruta de red",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/linea_en_ruta_red?lat=4.6737&lon=-74.0617&distancia=500&incluir_linea=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "linea_en_ruta_red"],
              "query": [
                { "key": "lat", "value": "4.6737", "description": "Latitud del punto de entrada (grados decimales WGS84)" },
                { "key": "lon", "value": "-74.0617", "description": "Longitud del punto de entrada (grados decimales WGS84)" },
                { "key": "distancia", "value": "500", "description": "Distancia a recorrer en metros por la red" },
                { "key": "incluir_linea", "value": "true", "description": "Devuelve geometria de la linea junto con los puntos (default: true)", "disabled": true }
              ]
            },
            "description": "Calcula una ruta en la red de cables desde un punto hasta una distancia. Retorna linea (GeoJSON) y puntos a la distancia.",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{username}}", "type": "string" },
                { "key": "password", "value": "{{password}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Nodos alcanzables en ruta de red",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/nodos_alcanzables_en_ruta_red?lat=4.6737&lon=-74.0617&distancia=500&margen_factor=0.9",
              "host": ["{{baseUrl}}"],
              "path": ["api", "nodos_alcanzables_en_ruta_red"],
              "query": [
                { "key": "lat", "value": "4.6737", "description": "Latitud del punto de inicio (grados decimales WGS84)" },
                { "key": "lon", "value": "-74.0617", "description": "Longitud del punto de inicio (grados decimales WGS84)" },
                { "key": "distancia", "value": "500", "description": "Distancia a recorrer en metros por la red" },
                { "key": "margen_factor", "value": "0.9", "description": "Margen de error como factor decimal (default: 0.9)", "disabled": true }
              ]
            },
            "description": "Retorna todos los nodos alcanzables desde un punto a una distancia. Indica el nodo mas cercano a la distancia solicitada y el nombre del cable.",
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{username}}", "type": "string" },
                { "key": "password", "value": "{{password}}", "type": "string" }
              ]
            }
          }
        }
      ]
    },
    {
